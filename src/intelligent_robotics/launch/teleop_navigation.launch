<?xml version="1.0"?>
<launch>

  <!--
    Block 1 - Robot environment camera viewer.
    This node displays /camera/color/image_raw so the operator can see the
    simulated robot environment.
  -->
  <node
    name="show_camera_robot"
    pkg="intelligent_robotics"
    type="show_camera_robot.py"
    output="screen">

    <param name="camera_image_topic" value="/camera/color/image_raw"/>
    <param name="camera_window_name" value="BLUE Robot Environment Camera"/>

  </node>


  <!--
    Block 2 - Operator image capture.
    This node obtains images from the operator webcam and publishes them in
    /operator/image.
  -->
  <node
    name="capture_video"
    pkg="intelligent_robotics"
    type="capture_video.py"
    output="screen">

    <param name="operator_image_topic" value="/operator/image"/>
    <param name="camera_index" value="0"/>
    <param name="publish_rate" value="30"/>
    <param name="display_preview" value="true"/>
    <param name="flip_operator_image" value="true"/>

  </node>


  <!--
    Block 3 - Gesture recognition and pre-safety command generation.
    This node reads /operator/image, applies MediaPipe Hands, recognises
    gestures, and publishes the command in /blue/preorder_ackermann_cmd.
  -->
  <node
    name="pose_estimation"
    pkg="intelligent_robotics"
    type="pose_estimation.py"
    output="screen">

    <param name="operator_image_topic" value="/operator/image"/>
    <param name="preorder_ackermann_topic" value="/blue/preorder_ackermann_cmd"/>
    <param name="invert_steering" value="false"/>

    <!--
      Temporal gesture confirmation.
      A movement gesture must be detected for several consecutive frames before
      being accepted. This reduces false positives from isolated MediaPipe errors.
    -->
    <param name="gesture_confirmation_frames" value="5"/>

    <!--
      Stop remains immediate for safety.
    -->
    <param name="stop_confirmation_frames" value="5"/>

    <!--
      If true, the robot stops while a new movement gesture is being confirmed.
      This is the safest option.
    -->
    <param name="stop_while_confirming_new_gesture" value="false"/>

  </node>


  <!--
    Block 4 - Obstacle detection from the BLUE Velodyne LiDAR.
    This node publishes /obstacles, which is consumed by the safety layer.
  -->
  <node
    name="obstacle_detection"
    pkg="intelligent_robotics"
    type="obstacle_detection.py"
    output="screen">

    <param name="point_cloud_topic" value="/blue/velodyne_points"/>
    <param name="obstacle_height_threshold" value="-0.45"/>
    <param name="free_zone_radius" value="6.0"/>

  </node>


  <!--
    Block 5 - Safety layer.
    This node receives /blue/preorder_ackermann_cmd and /obstacles, stops the
    robot when a collision risk is detected, and publishes the final command in
    /blue/ackermann_cmd.

    The original /blue/ackermann_controller from Gazebo will now subscribe to
    /blue/ackermann_cmd directly. Therefore, blue_ackermann_low_level_bridge.py
    is not launched.
  -->
  <node
    name="obstacle_avoidance"
    pkg="intelligent_robotics"
    type="obstacle_avoidance.py"
    output="screen">

    <param name="obstacle_topic" value="/obstacles"/>
    <param name="preorder_ackermann_topic" value="/blue/preorder_ackermann_cmd"/>
    <param name="safe_ackermann_topic" value="/blue/ackermann_cmd"/>

    <param name="vehicle_length" value="1.05"/>
    <param name="vehicle_half_width" value="0.45"/>
    <param name="minimum_detection_distance" value="0.35"/>
    <param name="maximum_detection_distance" value="2.50"/>
    <param name="maximum_reverse_detection_distance" value="2.00"/>
    <param name="collision_lateral_margin" value="0.35"/>

    <param name="maximum_allowed_speed" value="1.50"/>
    <param name="maximum_allowed_reverse_speed" value="0.90"/>
    <param name="maximum_allowed_steering_angle" value="0.60"/>
      
  </node>

</launch>