<?xml version="1.0"?>
<launch>

  <!--
    Block 1 - Robot camera viewer for Practice 2, Section 3.
    This node subscribes to the simulated environment camera topic and opens
    an OpenCV window so the operator can see the robot environment.
  -->
  <node
    name="show_camera_robot"
    pkg="intelligent_robotics"
    type="show_camera_robot.py"
    output="screen">

    <param name="camera_image_topic" value="/camera/color/image_raw"/>
    <param name="camera_window_name" value="BLUE Robot Environment Camera"/>

  </node>

</launch>